rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /guarantors/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /documents/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /familyProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /housekeeperProfiles/{userId} {
      allow read: if resource.data.verificationStatus == 'approved'
                  || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /verificationQueue/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null;
    }

    match /adminActions/{doc} {
      allow read, write: if request.auth != null;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
                    resource.data.familyId == request.auth.uid;
    }

    // Chat between one family and one housekeeper.
    // Chat id is "<uidA>_<uidB>" (the two uids, sorted).
    match /chats/{chatId} {
      // List queries filter on familyUid / hkUid, so check the stored fields.
      allow read: if request.auth != null &&
        (resource.data.familyUid == request.auth.uid ||
         resource.data.hkUid == request.auth.uid);
      // Only the two people in the chat can create or update it.
      allow create, update: if request.auth != null &&
        request.auth.uid in chatId.split('_') &&
        request.resource.data.familyUid in chatId.split('_') &&
        request.resource.data.hkUid in chatId.split('_');

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in chatId.split('_');
        // Send only as yourself; messages can't be edited or deleted.
        allow create: if request.auth != null &&
          request.auth.uid in chatId.split('_') &&
          request.resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
